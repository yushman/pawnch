; Top-left corner, above the pause and take-back controls, in the band Day 9
; cleared when the turn card was deleted. Every other corner is occupied by
; something a player is meant to read. It was bottom-right and then bottom-left,
; and each of those landed on top of one: the restart button, then the fourth
; row of white's graveyard. Neither failed a check; both were obvious in a frame.
[node name="DebugButton" type="Button" parent="."]
layout_mode = 1
anchors_preset = 0
offset_left = 10.0
offset_top = 14.0
offset_right = 90.0
offset_bottom = 70.0
text = "Дуэль"

[connection signal="pressed" from="DebugButton" to="DuelPanel" method="play"]
